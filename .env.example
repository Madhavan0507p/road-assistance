# =============================================================================
# On Road Vehicle Breakdown Assistance - Environment Variables
# Copy or set these in your Render.com Web Service Dashboard
# =============================================================================

# --- Aiven for MySQL Database Configuration ---
# You can find these in your Aiven Console -> Services -> Your MySQL Service Overview
DB_HOST=mysql-xxxxxx-your-account.aivencloud.com
DB_PORT=25432
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_SSL=true

# --- Alternative Single Connection URL (Aiven Service URI) ---
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxxxx.aivencloud.com:25432/defaultdb?ssl-mode=REQUIRED

# --- Application Public URL on Render ---
# Set this to your live Render URL so password reset & notification emails have working links
APP_URL=https://road-assistance.onrender.com

# --- Optional SMTP Email Configuration (for OTPs and email notifications) ---
# SMTP_USER=your_gmail_address@gmail.com
# SMTP_PASS=your_gmail_16_digit_app_password
