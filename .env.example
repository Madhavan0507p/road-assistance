# --- Live Aiven for MySQL Database Configuration ---
DB_HOST=mysql-9265eb3-madhavan0507p.a.aivencloud.com
DB_PORT=21533
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_SSL=true

# --- Alternative Single Connection URL (Aiven Service URI) ---
# DATABASE_URL=mysql://avnadmin:your_password@mysql-9265eb3-madhavan0507p.a.aivencloud.com:21533/defaultdb?ssl-mode=REQUIRED

# --- Application Public URL on Render ---
# Set this to your live Render URL once created
APP_URL=https://road-assistance.onrender.com

